# Fastfile for LifeMeter iOS App

default_platform(:ios)

platform :ios do
  
  # MARK: - Configuration
  
  before_all do
    setup_circle_ci if ENV['CI']
    ensure_git_status_clean unless ENV['CI']
  end
  
  # MARK: - Testing Lanes
  
  desc "Run all tests"
  lane :test do
    run_tests(
      scheme: "LifeMeter",
      devices: ["iPhone 15", "iPhone 15 Pro Max", "iPad Air (5th generation)"],
      code_coverage: true,
      output_directory: "./test_output"
    )
  end
  
  desc "Run unit tests only"
  lane :unit_tests do
    run_tests(
      scheme: "LifeMeter",
      testplan: "UnitTests",
      devices: ["iPhone 15"],
      code_coverage: true
    )
  end
  
  desc "Run UI tests only"
  lane :ui_tests do
    run_tests(
      scheme: "LifeMeter",
      testplan: "UITests",
      devices: ["iPhone 15"],
      code_coverage: true
    )
  end
  
  desc "Run widget tests"
  lane :widget_tests do
    run_tests(
      scheme: "LifeWidget",
      devices: ["iPhone 15"],
      code_coverage: true
    )
  end
  
  desc "Run performance tests"
  lane :performance_tests do
    run_tests(
      scheme: "LifeMeter",
      testplan: "PerformanceTests",
      devices: ["iPhone 15 mini"],
      code_coverage: false
    )
  end
  
  # MARK: - Build Lanes
  
  desc "Build for development"
  lane :build_dev do
    match(type: "development")
    gym(
      scheme: "LifeMeter",
      configuration: "Debug",
      export_method: "development",
      output_directory: "./build"
    )
  end
  
  desc "Build for App Store"
  lane :build_appstore do
    match(type: "appstore")
    gym(
      scheme: "LifeMeter",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build"
    )
  end
  
  # MARK: - Deployment Lanes
  
  desc "Deploy to TestFlight"
  lane :beta do
    # Increment build number
    increment_build_number(xcodeproj: "LifeMeter.xcodeproj")
    
    # Get certificates and provisioning profiles
    match(type: "appstore")
    
    # Build the app
    gym(
      scheme: "LifeMeter",
      configuration: "Release",
      export_method: "app-store"
    )
    
    # Upload to TestFlight
    upload_to_testflight(
      skip_waiting_for_build_processing: false,
      changelog: get_changelog_from_git_commits,
      distribute_external: true,
      groups: ["External Testers"],
      notify_external_testers: true
    )
    
    # Commit version bump
    commit_version_bump(
      message: "Version bump for TestFlight build",
      xcodeproj: "LifeMeter.xcodeproj"
    )
    
    # Tag the release
    add_git_tag(
      tag: "testflight/#{get_version_number(xcodeproj: 'LifeMeter.xcodeproj')}/#{get_build_number(xcodeproj: 'LifeMeter.xcodeproj')}"
    )
    
    push_to_git_remote
  end
  
  desc "Deploy to App Store"
  lane :release do
    # Ensure we're on main branch
    ensure_git_branch(branch: 'main')
    
    # Increment version number
    increment_version_number(xcodeproj: "LifeMeter.xcodeproj")
    increment_build_number(xcodeproj: "LifeMeter.xcodeproj")
    
    # Get certificates and provisioning profiles
    match(type: "appstore")
    
    # Build the app
    gym(
      scheme: "LifeMeter",
      configuration: "Release",
      export_method: "app-store"
    )
    
    # Upload to App Store
    upload_to_app_store(
      force: true,
      reject_if_possible: true,
      skip_metadata: false,
      skip_screenshots: false,
      submit_for_review: false,
      automatic_release: false,
      phased_release: true
    )
    
    # Commit version bump
    commit_version_bump(
      message: "Version bump for App Store release",
      xcodeproj: "LifeMeter.xcodeproj"
    )
    
    # Tag the release
    add_git_tag(
      tag: "v#{get_version_number(xcodeproj: 'LifeMeter.xcodeproj')}"
    )
    
    push_to_git_remote
    
    # Create GitHub release
    github_release = set_github_release(
      repository_name: "lifemeter/lifemeter-ios",
      api_token: ENV["GITHUB_TOKEN"],
      name: "v#{get_version_number(xcodeproj: 'LifeMeter.xcodeproj')}",
      tag_name: "v#{get_version_number(xcodeproj: 'LifeMeter.xcodeproj')}",
      description: get_changelog_from_git_commits,
      commitish: "main"
    )
  end
  
  # MARK: - Utility Lanes
  
  desc "Generate screenshots"
  lane :screenshots do
    capture_screenshots(
      scheme: "LifeMeterUITests",
      devices: [
        "iPhone 15 Pro Max",
        "iPhone 15",
        "iPhone SE (3rd generation)",
        "iPad Pro (12.9-inch) (6th generation)",
        "iPad (10th generation)"
      ],
      languages: ["en-US", "de-DE"],
      output_directory: "./screenshots"
    )
    
    frame_screenshots(
      path: "./screenshots",
      silver: true
    )
  end
  
  desc "Update metadata"
  lane :metadata do
    upload_to_app_store(
      skip_binary_upload: true,
      skip_screenshots: false,
      force: true
    )
  end
  
  desc "Sync certificates"
  lane :certificates do
    match(type: "development", force_for_new_devices: true)
    match(type: "appstore")
  end
  
  desc "Setup project for development"
  lane :setup do
    match(type: "development")
    cocoapods if File.exist?("Podfile")
  end
  
  desc "Run code quality checks"
  lane :quality do
    # SwiftLint
    swiftlint(
      mode: :lint,
      strict: true,
      raise_if_swiftlint_error: true
    )
    
    # SwiftFormat
    sh("swiftformat --lint .")
    
    # Check for TODO/FIXME comments
    sh("grep -r 'TODO\\|FIXME' --include='*.swift' . || true")
  end
  
  desc "Generate documentation"
  lane :docs do
    # Generate Swift documentation
    sh("swift-doc generate Sources --module-name LifeMeter --output docs/")
    
    # Generate API documentation
    jazzy(
      config: ".jazzy.yaml"
    )
  end
  
  # MARK: - Error Handling
  
  error do |lane, exception|
    slack(
      message: "❌ Lane #{lane} failed with exception: #{exception}",
      success: false
    ) if ENV['SLACK_URL']
  end
  
  # MARK: - Helper Methods
  
  private_lane :get_changelog_from_git_commits do
    changelog_from_git_commits(
      between: [last_git_tag, "HEAD"],
      pretty: "- %s",
      date_format: "short",
      match_lightweight_tag: false,
      merge_commit_filtering: "exclude_merges"
    )
  end
  
end

# MARK: - Custom Actions

def setup_signing
  match(
    type: "appstore",
    readonly: true,
    keychain_name: "fastlane_tmp_keychain",
    keychain_password: "temp_password"
  )
end

def cleanup_keychain
  delete_keychain(name: "fastlane_tmp_keychain") if File.exist? File.expand_path("~/Library/Keychains/fastlane_tmp_keychain-db")
end

